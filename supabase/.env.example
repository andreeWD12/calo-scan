# Segreti delle Edge Functions (`supabase secrets set NOME=valore`). Elenco completo di quelli letti dal codice.
# Questo file NON va mai nell'app né nel repository con valori veri (vedi .gitignore).
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY li fornisce Supabase da solo.

# AI (Fase 5 e 7)
ANTHROPIC_API_KEY=
AI_MODEL=
AI_EFFORT=
USDA_FDC_API_KEY=

# Abbonamenti: chiave In-App Purchase di App Store Connect (Fase 8)
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.andrewnalini.caloscan.app

# Servizi Apple: una chiave con APNs + DeviceCheck + Sign in with Apple (Fase 9)
APPLE_TEAM_ID=
APPLE_SERVICES_KEY_ID=
APPLE_SERVICES_PRIVATE_KEY=
# Segreto casuale (openssl rand -hex 32) usato da pg_cron per chiamare push-dispatch
PUSH_CRON_SECRET=

# Inviti (facoltativi)
APP_STORE_ID=
REFERRAL_DISCOUNT_LABEL=30%
REFERRAL_SHARE_URL=

# Solo sviluppo: account con piano Pro senza abbonamento. Da togliere prima del lancio.
TESTER_USER_IDS=
