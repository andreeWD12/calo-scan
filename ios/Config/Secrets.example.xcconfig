// Copia questo file in Secrets.xcconfig e compila i valori.
// Contiene SOLO valori pubblici: l'anon key di Supabase è progettata per stare nel client
// ed è protetta dalla Row Level Security. Nessuna chiave AI o service_role va qui.
//
// Nota xcconfig: "//" inizia un commento, quindi negli URL si scrive https:/$()/...
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-SUPABASE-ANON-KEY
GOOGLE_IOS_CLIENT_ID = YOUR-ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR-ID

// Pagine legali pubbliche (richieste da App Store Connect e dal GDPR)
PRIVACY_POLICY_URL = https:/$()/caloscan.app/privacy
TERMS_URL = https:/$()/caloscan.app/terms
SUPPORT_URL = https:/$()/caloscan.app/support

// ID numerico dell'app in App Store Connect (Informazioni app › Apple ID). Serve per il link di
// riscatto con il codice già compilato (premio degli inviti). Vuoto = si apre il foglio di Apple.
APP_STORE_ID =
